# Copy to .env to use a real LLM. Without it the system runs on the mock LLM.
# Compose reads this file into the API, the worker, setup and the mock provider.
# mock | anthropic | openai. A chosen provider without its key fails at startup.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5, the Claude model the benchmark measured.
# ANTHROPIC_MODEL=claude-haiku-5-5

OPENAI_API_KEY=
# Defaults to gpt-6-luna, the OpenAI model the benchmark measured.
# OPENAI_MODEL=gpt-6-luna

# Most provider calls a second on each channel, across every worker.
# RATE_LIMIT_PER_SECOND=100

# Fake customers created on the first start. Changing it later needs `docker compose down -v`.
# SEED_USER_COUNT=6000

# Signs the mock provider's events. Compose uses a local default when this is unset.
# PROVIDER_WEBHOOK_SECRET=

# Signs the unsubscribe links in emails. Compose uses a local default when this is unset.
# UNSUBSCRIBE_SECRET=
# Where those links point.
# PUBLIC_URL=http://localhost:8080

# Optional: export traces over OTLP, for example to Jaeger.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Optional: serve Go's pprof profiles inside each container, for example on :6060.
# PPROF_ADDR=

# How much trouble the mock provider causes, as fractions of requests.
# MOCK_RATE_LIMIT_RATE=0.02
# MOCK_SERVER_ERROR_RATE=0.03
# MOCK_LOST_RESPONSE_RATE=0.002
# MOCK_BOUNCE_RATE=0.03

# How long the mock provider takes to answer, in milliseconds.
# MOCK_MIN_DELAY_MS=10
# MOCK_MAX_DELAY_MS=60
# A share of calls that answer slowly instead, between the two times below. Off by default.
# MOCK_SLOW_RATE=0
# MOCK_SLOW_MIN_MS=
# MOCK_SLOW_MAX_MS=

# The mock provider's own limit per channel, refusing calls over it with 429. 0 leaves it off.
# MOCK_RATE_PER_SECOND=0
# Channels whose credentials the mock provider refuses, for example sms,email.
# MOCK_UNAUTHORIZED_CHANNELS=
